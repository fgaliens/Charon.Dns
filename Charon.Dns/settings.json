{
  "LogLevel": "Information",
  "FileLogLevel": "Debug",
  "Server": {
    "MaxParallelRequestCount": 8,
    "SocketBufferSize": "2Mb",
    "ListenOn": [
      {
        "Address": "10.0.0.53",
        "Port": 53,
        "EnableIpV6": false
      }
    ],
    "DnsChain": {
      "ResolvingStrategy": "RoundRobin",
      "ResolvingConcurrencyLimit": 2,
      "SocketBufferSize": "512Kb",
      "DefaultServers": [
        "77.88.8.8:53",
        "77.88.8.1"
      ],
      "SecuredServers": [
        {
          "Ip": "1.1.1.1:53",
          "RouteThroughInterface": "wg0"
        },
        {
          "Ip": "8.8.8.8",
          "RouteThroughInterface": "wg0"
        }
      ]
    }
  },
  "Cache": {
    "Enabled": true,
    "TimeToLive": "00:05:00"
  },
  "UserAccessControl": {
    "Enabled": false,
    "InactivityThreshold": "00:30:00",
    "ControlledIps": [
      "10.8.0.0/24"
    ]
  }
}