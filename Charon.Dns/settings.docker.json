{
  "Logging": {
    "Console": "Debug",
    "File": "Warning"
  },
  "Server": {
    "SocketsPerEndpoint": 16,
    "SocketBufferSize": "4Mb",
    "ListenOn": [
      {
        "Address": "0.0.0.0",
        "Port": 53
      },
      {
        "Address": "10.0.0.53",
        "Port": 53
      }
    ]
  },
  "Upstream": {
    "ResolvingStrategy": "RoundRobin",
    "SocketBufferSize": "1Mb",
    "DefaultServers": [
      "77.88.8.8:53",
      "77.88.8.1"
    ],
    "RoutedServers": [
      {
        "Address": "1.1.1.1:53",
        "Interface": "wg0"
      },
      {
        "Address": "8.8.8.8",
        "Interface": "wg0"
      }
    ]
  },
  "Cache": {
    "Enabled": true,
    "Ttl": "00:05:00"
  },
  "UserAccessControl": {
    "Enabled": false,
    "InactivityThreshold": "00:30:00",
    "ControlledSubnets": [
      "10.8.0.0/24"
    ]
  }
}