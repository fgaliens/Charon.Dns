{
  "Logging": {
    "Console": "Information",
    "File": "Debug"
  },
  "Server": {
    "SocketsPerEndpoint": 8,
    "SocketBufferSize": "2Mb",
    "ListenOn": [
      {
        "Address": "10.0.0.53",
        "Port": 53,
        "EnableIPv6": false,
        "Mode": "UdpAndTcp"
      }
    ]
  },
  "Upstream": {
    "ResolvingStrategy": "RoundRobin",
    "SocketBufferSize": "512Kb",
    "DefaultServers": [
      {
        "Address": "77.88.8.8:53",
        "Mode": "UdpAndTcp"
      },
      {
        "Address": "77.88.8.1",
        "Mode": "UdpAndTcp"
      }
    ],
    "RoutedServers": [
      {
        "Address": "1.1.1.1:53",
        "Interface": "wg0",
        "Mode": "UdpAndTcp"
      },
      {
        "Address": "8.8.8.8",
        "Interface": "wg0",
        "Mode": "UdpAndTcp"
      }
    ]
  },
  "Cache": {
    "Enabled": true,
    "Ttl": "00:05:00"
  },
  "UserAccessControl": {
    "Enabled": false,
    "InactivityThreshold": "00:30:00",
    "ControlledSubnets": [
      "10.8.0.0/24"
    ]
  }
}